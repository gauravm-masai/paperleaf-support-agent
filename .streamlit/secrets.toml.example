# Copy this file to secrets.toml (same folder) and fill in your own values.
# secrets.toml is never uploaded to Git. On Streamlit Community Cloud, paste the same lines
# into the app's Secrets box instead.

# Passcode for customers (opens a fresh chat).
APP_PASSCODE = "choose-a-customer-passcode"

# Passcode for the admin (shows all chats and open tickets). Make it different.
ADMIN_PASSCODE = "choose-an-admin-passcode"

# Only needed when deployed. On your laptop these come from the .env file.
GOOGLE_API_KEY = "paste-your-key-here"
GEMINI_MODEL = "paste-the-model-name-here"
